# Dependencies (monorepo-safe: all subfolders)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build outputs
.next/
out/
dist/
build/

# Testing & Coverage
coverage/

# Misc & OS
.DS_Store
Thumbs.db
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (keep .example files, ignore live secrets)
.env
.env*.local
.env.production
.env.local
.env.development
backend/.env
bot/.env
frontend/.env.local

# Allow example environment templates
!.env.example
!backend/.env.example
!bot/.env.example
!frontend/.env.example

# Vercel
.vercel/

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
.sessions.json
