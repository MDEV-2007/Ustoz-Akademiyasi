# ==============================================================================
# USTOZ AKADEMIYASI — TELEGRAM BOT CONFIGURATION
# ==============================================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=

# Runtime Mode: 'polling' (local dev & standalone) or 'webhook' (production)
BOT_MODE=polling

# Webhook configuration (only needed if BOT_MODE=webhook)
BOT_WEBHOOK_URL=https://bot.ustozakademiyasi.uz/webhook
BOT_WEBHOOK_SECRET=super_secret_webhook_token_xyz_2026
BOT_WEBHOOK_PORT=3001

# NestJS Backend API URL
BACKEND_API_URL=http://localhost:4000/api/v1

# Shared Service Token for Admin & Machine-to-Machine API access
BOT_API_TOKEN=ustoz_bot_secure_service_token_2026

# Authorized Telegram User IDs for Admin Commands (/admin, /leads, /lead_status)
# Comma-separated integer IDs. Example: 12345678,98765432
ADMIN_TELEGRAM_IDS=

# Target Chat ID for Admin Lead Notifications
ADMIN_NOTIFICATION_CHAT_ID=

# Redis URL for restart-safe session persistence (optional, falls back to local disk)
REDIS_URL=redis://localhost:6379

# Official Public Website URL
PUBLIC_WEBSITE_URL=https://ustozakademiyasi.uz

# Log Level: debug | info | warn | error
LOG_LEVEL=info
