# Application
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
PUBLIC_APP_URL=https://ustozakademiyasi.uz
API_PUBLIC_URL=https://api.ustozakademiyasi.uz

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/ustoz_akademiyasi?schema=public"
DATABASE_TEST_URL="postgresql://username:password@localhost:5432/ustoz_akademiyasi_test?schema=public"

# Authentication & JWT
JWT_ACCESS_SECRET="generate-a-strong-random-32-byte-secret"
JWT_REFRESH_SECRET="generate-a-strong-random-64-byte-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Initial Super Admin Bootstrap
SUPERADMIN_EMAIL="admin@ustozakademiyasi.uz"
SUPERADMIN_PASSWORD="ReplaceWithStrongAdminPassword!"
SUPERADMIN_NAME="Bosh Administrator"

# CORS
CORS_ORIGINS="https://ustozakademiyasi.uz"

# Redis & Background Queues
REDIS_URL="redis://localhost:6379"

# Telegram Bot Notifications & Service Authentication
TELEGRAM_BOT_TOKEN="123456789:ABCDefGhIJklMNopQRstUVwxyz"
TELEGRAM_CHAT_IDS="-100123456789"
BOT_API_TOKEN="secure_bot_service_token_2026_xyz"

# Storage / Uploads
STORAGE_PROVIDER="local"
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR="uploads"
