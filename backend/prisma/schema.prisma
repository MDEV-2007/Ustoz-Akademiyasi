datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CONTENT_EDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GeneralStatus {
  ACTIVE
  INACTIVE
}

enum RegistrationStatus {
  NEW
  CONTACTED
  CALLBACK
  INTERESTED
  TRIAL_BOOKED
  ENROLLED
  NOT_INTERESTED
  UNREACHABLE
  DUPLICATE
  SCHEDULED
  ATTENDED
  CONVERTED
  CANCELLED
  SPAM
}

// -----------------------------------------------------------------------------
// 1. ADMIN, USERS & AUTHENTICATION
// -----------------------------------------------------------------------------

model User {
  id           String      @id @default(cuid())
  fullName     String
  email        String      @unique
  phone        String?
  passwordHash String
  role         UserRole    @default(MANAGER)
  status       UserStatus  @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  refreshTokens          RefreshToken[]
  assignedRegistrations  TrialRegistration[]        @relation("AssignedManager")
  statusHistoryChanges   RegistrationStatusHistory[] @relation("StatusChangedBy")
  authoredArticles       Article[]                  @relation("AuthoredArticles")
  uploadedMedia          MediaAsset[]               @relation("UploadedMedia")
  auditLogs              AuditLog[]

  @@index([email])
  @@index([role, status])
}

model RefreshToken {
  id               String    @id @default(cuid())
  userId           String
  tokenHash        String    @unique
  expiresAt        DateTime
  revoked          Boolean   @default(false)
  revokedAt        DateTime?
  replacedByToken  String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// -----------------------------------------------------------------------------
// 2. COURSES & CATEGORIES
// -----------------------------------------------------------------------------

model CourseCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  sortOrder   Int           @default(0)
  status      GeneralStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  courses     Course[]

  @@index([slug])
  @@index([status, sortOrder])
}

model Course {
  id                String        @id @default(cuid())
  title             String
  slug              String        @unique
  shortDescription  String
  description       String
  categoryId        String
  targetAudience    String
  level             String
  durationMonths    Int?          @default(3)
  priceAmount       Decimal?      @db.Decimal(12, 2)
  currency          String        @default("UZS")
  ageMinimum        Int?
  ageMaximum        Int?
  entryRequirements String?
  durationNote      String?
  priceStatus       String?
  methodology       String?
  plateType         String?       @default("phonetics-calligraphy")
  coverImage        String?
  status            ContentStatus @default(PUBLISHED)
  featured          Boolean       @default(false)
  metaTitle         String?
  metaDescription   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category          CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  outcomes          CourseOutcome[]
  syllabusModules   CourseModule[]
  faqs              CourseFaq[]
  branchCourses     BranchCourse[]
  schedules         CourseSchedule[]
  registrations     TrialRegistration[]
  testimonials      Testimonial[]

  @@index([slug])
  @@index([categoryId, status])
  @@index([status, featured])
}

model CourseOutcome {
  id        String   @id @default(cuid())
  courseId  String
  text      String
  sortOrder Int      @default(0)

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  topics    String
  sortOrder Int      @default(0)

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
}

model CourseFaq {
  id        String   @id @default(cuid())
  courseId  String
  question  String
  answer    String
  sortOrder Int      @default(0)

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
}

// -----------------------------------------------------------------------------
// 3. BRANCHES & BRANCH-COURSE AVAILABILITY
// -----------------------------------------------------------------------------

model Branch {
  id              String        @id @default(cuid())
  name            String
  officialLabel   String
  slug            String        @unique
  district        String?
  area            String
  address         String?
  addressNote     String?
  landmark        String?
  latitude        Float?
  longitude       Float?
  phone           String?
  workingHours    String        @default("Dushanba – Shanba (guruhlar jadvali bo‘yicha)")
  description     String?
  highlight       String?
  images          String[]      @default([])
  status          GeneralStatus @default(ACTIVE)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  branchCourses   BranchCourse[]
  schedules       CourseSchedule[]
  registrations   TrialRegistration[]
  testimonials    Testimonial[]

  @@index([slug])
  @@index([status])
}

model BranchCourse {
  branchId  String
  courseId  String
  createdAt DateTime @default(now())

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([branchId, courseId])
  @@index([branchId])
  @@index([courseId])
}

// -----------------------------------------------------------------------------
// 4. TEACHERS & DEPARTMENTS
// -----------------------------------------------------------------------------

model Teacher {
  id                String        @id @default(cuid())
  fullName          String
  slug              String        @unique
  department        String
  badge             String?
  qualification     String
  focus             String
  biography         String?
  photo             String?
  yearsOfExperience Int?          @default(3)
  languages         String[]      @default(["Arab tili", "O'zbek tili"])
  displayOrder      Int           @default(0)
  status            GeneralStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  schedules         CourseSchedule[]

  @@index([slug])
  @@index([status, displayOrder])
}

// -----------------------------------------------------------------------------
// 5. COURSE SCHEDULES
// -----------------------------------------------------------------------------

model CourseSchedule {
  id         String        @id @default(cuid())
  courseId   String
  branchId   String
  teacherId  String?
  daysOfWeek String[]      // e.g. ["DUSHANBA", "CHORSHANBA", "JUMA"]
  startTime  String        // e.g. "09:00"
  endTime    String        // e.g. "10:30"
  startDate  DateTime?
  endDate    DateTime?
  capacity   Int           @default(12)
  enrolled   Int           @default(0)
  status     GeneralStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  branch     Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  teacher    Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([courseId, branchId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// 6. TRIAL REGISTRATIONS (LEADS) & STATUS HISTORY
// -----------------------------------------------------------------------------

model TrialRegistration {
  id                 String             @id @default(cuid())
  referenceId        String             @unique // e.g. "UA-148067"
  fullName           String
  phone              String             // Normalized E.164: +998901234567
  phoneFormatted     String             // Display format: +998 90 123-45-67
  courseId           String
  branchId           String
  preferredTime      String?
  notes              String?
  status             RegistrationStatus @default(NEW)
  source             String             @default("WEBSITE")
  inquiryType        String             @default("TRIAL_LESSON")
  assignedManagerId  String?
  internalNotes      String?
  contactedAt        DateTime?
  scheduledDate      DateTime?
  callbackTime       DateTime?
  telegramUserId     String?
  telegramUsername   String?
  telegramChatId     String?
  telegramMessageId  Int?
  notificationStatus String             @default("PENDING") // PENDING, SENT, FAILED
  notificationError  String?
  lastNotificationAt DateTime?
  idempotencyKey     String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  course             Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedManager    User?              @relation("AssignedManager", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  statusHistory      RegistrationStatusHistory[]

  @@index([referenceId])
  @@index([phone])
  @@index([status, createdAt])
  @@index([courseId, branchId])
  @@index([assignedManagerId])
  @@index([notificationStatus])
}

model RegistrationStatusHistory {
  id             String             @id @default(cuid())
  registrationId String
  fromStatus     RegistrationStatus
  toStatus       RegistrationStatus
  changedById    String?
  comment        String?
  createdAt      DateTime           @default(now())

  registration   TrialRegistration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  changedBy      User?              @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([registrationId, createdAt])
}

// -----------------------------------------------------------------------------
// 7. ARTICLES & EDUCATIONAL RESOURCES
// -----------------------------------------------------------------------------

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String
  content         String?
  intro           String?
  coverImage      String?
  topic           String
  sourceNote      String?
  readTime        String        @default("4 daqiqa")
  authorId        String?
  status          ContentStatus @default(PUBLISHED)
  publishedAt     DateTime      @default(now())
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author          User?         @relation("AuthoredArticles", fields: [authorId], references: [id], onDelete: SetNull)
  items           ArticleItem[]

  @@index([slug])
  @@index([status, publishedAt])
  @@index([topic])
}

model ArticleItem {
  id          String   @id @default(cuid())
  articleId   String
  arabicText  String
  translit    String
  translation String
  sortOrder   Int      @default(0)

  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, sortOrder])
}

// -----------------------------------------------------------------------------
// 8. FREQUENTLY ASKED QUESTIONS (FAQ)
// -----------------------------------------------------------------------------

model FAQ {
  id        String        @id @default(cuid())
  question  String
  answer    String
  category  String
  sortOrder Int           @default(0)
  status    GeneralStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([category, status])
  @@index([status, sortOrder])
}

// -----------------------------------------------------------------------------
// 9. TESTIMONIALS & ACHIEVEMENTS
// -----------------------------------------------------------------------------

model Testimonial {
  id               String        @id @default(cuid())
  displayName      String
  text             String
  courseId         String?
  branchId         String?
  rating           Int?          @default(5)
  photo            String?
  consentConfirmed Boolean       @default(false)
  status           ContentStatus @default(PUBLISHED)
  displayOrder     Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  course           Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  branch           Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([status, consentConfirmed, displayOrder])
}

model Achievement {
  id           String        @id @default(cuid())
  title        String
  description  String?
  value        String        // e.g. "15,000+"
  unit         String?       // e.g. "bitiruvchilar"
  icon         String?       // e.g. "Award", "Users", "MapPin"
  displayOrder Int           @default(0)
  status       GeneralStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, displayOrder])
}

// -----------------------------------------------------------------------------
// 10. MEDIA ASSETS
// -----------------------------------------------------------------------------

model MediaAsset {
  id               String   @id @default(cuid())
  storageKey       String   @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  altText          String?
  uploadedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  uploadedBy       User?    @relation("UploadedMedia", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([storageKey])
  @@index([mimeType])
}

// -----------------------------------------------------------------------------
// 11. SITE SETTINGS
// -----------------------------------------------------------------------------

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key, isPublic])
}

// -----------------------------------------------------------------------------
// 12. AUDIT LOGS
// -----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g. "USER_LOGIN", "UPDATE_COURSE", "STATUS_CHANGE"
  entityType String   // e.g. "Course", "TrialRegistration", "User"
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}
